# .env es OPCIONAL en modo CLI. El programa usa el 'claude' CLI
# que ya tenes instalado y su autenticacion (Max plan / OAuth / lo que sea).
# No hace falta ANTHROPIC_API_KEY.

# opcional: forzar un modelo especifico (sino usa tu default de claude code)
# posibles: haiku  |  sonnet  |  opus  |  claude-haiku-5-5  |  claude-sonnet-5-5  |  claude-opus-5-5
# haiku es mucho mas barato y suele alcanzar para preguntas simples
# RESPUESTASINADOR_MODEL=haiku

# opcional: timeout en segundos por llamada
# RESPUESTASINADOR_TIMEOUT=90

# opcional: cambiar hotkeys
# RESPUESTASINADOR_HOTKEY_SCAN=f8
# RESPUESTASINADOR_HOTKEY_QUIT=f9
# RESPUESTASINADOR_HOTKEY_CLEAR=     # vacio = sin hotkey de limpieza (default)

# opcional: aspecto de la X (defaults: tamano=7, grosor=2, color rosa muy sutil, sin label)
# RESPUESTASINADOR_X_SIZE=7
# RESPUESTASINADOR_X_THICK=2
# RESPUESTASINADOR_X_COLOR=#ff5577
# RESPUESTASINADOR_X_LABEL=0        # 1 para mostrar la letra/numero al lado
