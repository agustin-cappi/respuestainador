# backend seleccionado: Claude Code (default)
RESPUESTASINADOR_BACKEND=claude

# opcional: modelo especifico (si no, usa el default de claude code)
# posibles: haiku  |  sonnet  |  opus
# haiku es mucho mas barato y rapido, menos preciso
# RESPUESTASINADOR_MODEL=haiku

# opcional: hotkeys
# RESPUESTASINADOR_HOTKEY_SCAN=f8
# RESPUESTASINADOR_HOTKEY_QUIT=f9

# opcional: aspecto de la X
# RESPUESTASINADOR_X_SIZE=7
# RESPUESTASINADOR_X_THICK=2
# RESPUESTASINADOR_X_COLOR=#000000
# RESPUESTASINADOR_X_LABEL=0

# opcional: timeout en segundos por llamada
# RESPUESTASINADOR_TIMEOUT=120
